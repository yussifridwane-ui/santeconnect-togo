# URL de connexion à votre base de données PostgreSQL (ex. Supabase, Neon.tech, ou Railway)
DATABASE_URL=postgresql://postgres:votre_mot_de_passe@votre_hote_postgres:5432/nom_de_bdd?sslmode=require

# Clé de chiffrement secrète pour les sessions JWT Jose de SantéConnect
JWT_SECRET=togo-health-messaging-secret-key-2024-remplacez-moi-en-production

# Configuration optionnelle de l'environnement
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://votre-santeconnect-app.vercel.app

# Paiement Mobile Money (Flooz & T-Money) via CinetPay
# Sans ces clés, les paiements fonctionnent en MODE DÉMO (simulés).
# Obtenez-les sur https://cinetpay.com (dashboard > API Keys)
CINETPAY_API_KEY=votre_cle_api_cinetpay
CINETPAY_SITE_ID=votre_id_site_cinetpay

# Paiement MANUEL Mixx by Yas (numéro receveur affiché aux clients)
TMONEY_NUMBER=+228 90 11 22 33
PAYMENT_BENEFICIARY=Ridwane Issifou — SantéConnect Togo

# Flooz : masqué par défaut. Le jour où vous l'aurez :
# ENABLE_FLOOZ=true
# FLOOZ_NUMBER=+228 XX XX XX XX
